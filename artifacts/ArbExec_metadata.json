			"kind": "dev",
			"methods": {
				"constructor": {
					"params": {
						"_a": "Aave V3 lending pool address, or address(0) to disable Aave flash loans.",
						"_b": "Balancer Vault address, or address(0) to disable Balancer flash loans.",
						"_q": "View-only Quoter address for simulating V3 swap outputs.",
						"_w": "WETH token address used for unwrapping profits."
					}
				},
				"execute((uint256,uint256,address[],address[],uint24[],address,address,uint8),bool,bool,uint256)": {
					"details": "Validates the path, determines the borrow amount if not supplied, then      initiates a flash loan or flash swap from the preferred source.      Use the `ad` return value from getProfit() as the `arb` argument here      to ensure the borrow amount and sorted pools are consistent with the simulation.",
					"params": {
						"arb": "Arbitrage parameters including token path, pools, fees, and constraints.",
						"forceAave": "If true, forces borrowing via Aave flash loan (requires AAVE_POOL set).",
						"forceBalancer": "If true, forces borrowing via Balancer flash loan (requires BALANCER_VAULT set).                      forceAave takes precedence over forceBalancer if both are true.                      If neither is true, borrows via a pool flash swap."
					}
				},
				"executeOperation(address[],uint256[],uint256[],address,bytes)": {
					"details": "Called by the Aave pool after funds are transferred to this contract.      Executes the arb trade, then repays the loan plus Aave's premium.      Reverts if caller is not the expected Aave pool or initiator is not this contract.",
					"params": {
						"amounts": "Amounts borrowed (single element array).",
						"assets": "Token addresses borrowed (single element array).",
						"initiator": "Must equal address(this) — guards against third-party flash loan injection.",
						"params": "ABI-encoded (ArbData, borrowAmt, startBalance).",
						"premiums": "Aave fees owed on top of the borrowed amounts."
					},
					"returns": {
						"_0": "True on success, as required by the Aave interface."
					}
				},
				"owner()": {
					"details": "Returns the address of the current owner."
				},
				"renounceOwnership()": {
					"details": "Leaves the contract without owner. It will not be possible to call `onlyOwner` functions. Can only be called by the current owner. NOTE: Renouncing ownership will leave the contract without an owner, thereby disabling any functionality that is only available to the owner."
				},
				"transferOwnership(address)": {
					"details": "Transfers ownership of the contract to a new account (`newOwner`). Can only be called by the current owner."
				}
			},
			"version": 1
		},
