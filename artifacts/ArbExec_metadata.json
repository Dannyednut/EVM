			"kind": "dev",
			"methods": {
				"constructor": {
					"params": {
						"_a": "Aave V3 lending pool address, or address(0) to disable Aave flash loans.",
						"_b": "Balancer Vault address, or address(0) to disable Balancer flash loans.",
						"_q": "View-only Quoter address for simulating V3 swap outputs.",
						"_w": "WETH token address used for unwrapping profits."
					}
				},
				"execute((address[],address[],uint256,address,address,uint24[],uint256,uint8),bool,bool)": {
					"details": "Validates the path, determines the borrow amount if not supplied, then      initiates a flash loan or flash swap from the preferred source.      Use the `ad` return value from getProfit() as the `arb` argument here      to ensure the borrow amount and sorted pools are consistent with the simulation.",
					"params": {
						"arb": "Arbitrage parameters including token path, pools, fees, and constraints.",
						"forceAave": "If true, forces borrowing via Aave flash loan (requires AAVE_POOL set).",
						"forceBalancer": "If true, forces borrowing via Balancer flash loan (requires BALANCER_VAULT set).                      forceAave takes precedence over forceBalancer if both are true.                      If neither is true, borrows via a pool flash swap."
					}
				},
				"executeOperation(address[],uint256[],uint256[],address,bytes)": {
					"details": "Called by the Aave pool after funds are transferred to this contract.      Executes the arb trade, then repays the loan plus Aave's premium.      Reverts if caller is not the expected Aave pool or initiator is not this contract.",
					"params": {
						"amounts": "Amounts borrowed (single element array).",
						"assets": "Token addresses borrowed (single element array).",
						"initiator": "Must equal address(this) — guards against third-party flash loan injection.",
						"params": "ABI-encoded (ArbData, borrowAmt, startBalance).",
						"premiums": "Aave fees owed on top of the borrowed amounts."
					},
					"returns": {
						"_0": "True on success, as required by the Aave interface."
					}
				},
				"getProfit((address[],address[],uint256,address,address,uint24[],uint256,uint8))": {
					"details": "Safe to call from view contexts and other contracts since it uses the view-only Quoter.      Internally calls _determineBorrowAmount to sort pools and set amountIn if not supplied.      V3 hops are simulated via the Quoter; V2 hops use the constant-product reserve formula.      The returned `ad` struct should be passed directly to execute() to ensure the borrow      amount and pool ordering used in simulation match what execute() will use.",
					"params": {
						"arb": "Arbitrage parameters to simulate. amountIn may be 0 for auto-calculation."
					},
					"returns": {
						"ad": "    Updated ArbData with amountIn set and pools sorted — pass this to execute().",
						"profit": "Expected profit in tokenIn after repaying the borrow. 0 means not profitable."
					}
				},
				"owner()": {
					"details": "Returns the address of the current owner."
				},
				"receiveFlashLoan(address[],uint256[],uint256[],bytes)": {
					"details": "Called by the Balancer Vault after funds are transferred to this contract.      Executes the arb trade, then repays the loan plus any Balancer fees.      Reverts if caller is not the expected Balancer Vault.",
					"params": {
						"amounts": "Amounts borrowed.",
						"feeAmounts": "Balancer fees owed on top of the borrowed amounts.",
						"tokens": "Token addresses borrowed.",
						"userData": "ABI-encoded (ArbData, borrowAmt, startBalance)."
					}
				},
				"renounceOwnership()": {
					"details": "Leaves the contract without owner. It will not be possible to call `onlyOwner` functions. Can only be called by the current owner. NOTE: Renouncing ownership will leave the contract without an owner, thereby disabling any functionality that is only available to the owner."
				},
				"transferOwnership(address)": {
					"details": "Transfers ownership of the contract to a new account (`newOwner`). Can only be called by the current owner."
				},
				"uniswapV2Call(address,uint256,uint256,bytes)": {
					"details": "Called by a V2 pair after tokens are transferred to this contract.      Also invoked by the fallback for non-standard V2 fork callback selectors.      Mode 0: repays the borrowed token plus 0.3% fee to the borrow pair.      Mode 1: repays the debt token (the other side of the pair) computed at initiation.      Reverts if caller is not the expected pair or sender is not this contract.",
					"params": {
						"amount0": "Amount of token0 received from the pair (0 if token1 was borrowed).",
						"amount1": "Amount of token1 received from the pair (0 if token0 was borrowed).",
						"data": "ABI-encoded V2CB struct containing arb params and repayment details.",
						"sender": "Must equal address(this) — the initiator of the flash swap."
					}
				},
				"uniswapV3FlashCallback(uint256,uint256,bytes)": {
					"details": "Called by a V3 pool after pool.flash() transfers tokens to this contract.      Executes the arb trade then repays the pool the borrowed amount plus fees.      Reverts if caller is not the expected pool.",
					"params": {
						"data": "ABI-encoded (ArbData, borrowAmt, startBalance).",
						"f0": "Fee owed on token0 (0 if token1 was borrowed).",
						"f1": "Fee owed on token1 (0 if token0 was borrowed)."
					}
				},
				"uniswapV3SwapCallback(int256,int256,bytes)": {
					"details": "Called by a V3 pool during swap execution.      Handles two internal modes encoded in the data payload:      Mode 1 (internal swap hop): called during _swap() for each V3 hop in the trade path.                                  Transfers the owed token directly to the pool and returns.      Mode 2 (flash swap entry):  called when pools[0] is used as the flash swap source.                                  Executes the arb trade starting from pools[1], then repays                                  the owed amounts to pools[0].      Reverts if caller is not the expected pool.",
					"params": {
						"a0": "Amount of token0 owed to the pool (positive) or received (negative).",
						"a1": "Amount of token1 owed to the pool (positive) or received (negative).",
						"data": "ABI-encoded payload beginning with a uint8 mode discriminator."
					}
				},
				"withdraw(address,uint256)": {
					"details": "Passing amount = 0 withdraws the entire balance of the token.      Passing token = address(0) ignores amount and withdraws all ETH.",
					"params": {
						"amount": "The amount to withdraw, or 0 to withdraw the full balance.",
						"token": "The ERC20 token address to withdraw, or address(0) for ETH."
					}
				}
			},
			"version": 1
		},
